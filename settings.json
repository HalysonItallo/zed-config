{
 "vim_mode": false,
 "auto_install_extensions":{
   "html": true,
   "toml": true,
   "dockerfile": true,
  "docker-compose": true,
   "material-icon-theme": true,
   "biome": true,
   "mcp-server-context7": true,
   "python-requirements": true,
   "jinja2": true,
   "moonlight": true,
   "git-firefly": true,
  "just": true,
 },
 "edit_predictions": {
  "mode": "eager"
 },
 "agent": {
		"default_profile": "write",
		"default_model": {
			"provider": "copilot_chat",
			"model": "claude-sonnet-4.5"
		},
		"model_parameters": []
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"features": {
		"edit_prediction_provider": "copilot"
	},
	"buffer_font_family": "JetBrains Mono",
	"icon_theme": {
		"mode": "dark",
		"light": "Zed (Default)",
		"dark": "Material Icon Theme"
	},
	"cursor_shape": "block",
	"ui_font_size": 16,
	"buffer_font_size": 15,
	"project_panel": { "auto_fold_dirs": false },
	"theme": {
		"mode": "dark",
		"light": "Ayu Light",
		"dark": "Moonlight Italic"
	},
	"profiles": {
		"PythonRuff": {
			"languages": {
				"Python": {
					"format_on_save": "on",
					"language_servers": ["basedpyright", "ruff"],
					"formatter": { "language_server": { "name": "ruff" } }
				}
			},
			"lsp": {
				"basedpyright": {
					"settings": {
						"basedpyright.analysis": { "typeCheckingMode": "off" }
					}
				},
				"ruff": {
					"initialization_options": {
						"settings": {
							"configuration": "pyproject.toml"
						}
					}
				}
			}
		},
		"PythonBlack": {
			"languages": {
				"Python": {
					"format_on_save": "on",
					"language_servers": ["basedpyright"],
					"formatter": {
						"external": {
							"command": "sh",
							"arguments": [
								"-c",
								"venv/bin/isort - --profile black | venv/bin/black -"
							]
						}
					}
				}
			},
			"lsp": {
				"basedpyright": {
					"settings": {
						"basedpyright.analysis": { "typeCheckingMode": "off" }
					}
				}
			}
		}
	},
	"languages": {
	  "Python": {
			"language_servers": ["!basedpyright"]
		},
		"Go": {
			"format_on_save": "on"
		},
		"JavaScript": {
			"format_on_save": "on",
			"language_servers": ["biome", "typescript-language-server"],
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TypeScript": {
			"format_on_save": "on",
			"language_servers": ["biome", "typescript-language-server"],
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JSX": {
			"format_on_save": "on",
			"language_servers": ["biome", "typescript-language-server"],
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TSX": {
			"format_on_save": "on",
			"language_servers": ["biome", "typescript-language-server"],
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JSON": {
			"format_on_save": "on",
			"language_servers": ["biome"],
			"formatter": { "language_server": { "name": "biome" } }
		},
		"JSONC": {
			"format_on_save": "on",
			"language_servers": ["biome"],
			"formatter": { "language_server": { "name": "biome" } }
		},
		"CSS": {
			"format_on_save": "on",
			"language_servers": ["biome"],
			"formatter": { "language_server": { "name": "biome" } }
		}
	},
	"lsp": {
		"gopls": {
			"initialization_options": {
				"hints": {
					"assignVariableTypes": true,
					"compositeLiteralFields": true,
					"compositeLiteralTypes": true,
					"constantValues": true,
					"functionTypeParameters": true,
					"parameterNames": true,
					"rangeVariableTypes": true
				}
			}
		},
		"biome": {
			"settings": {
				"require_config_file": true
			}
		},
		"basedpyright": {
			"settings": {
				"basedpyright.analysis": { "typeCheckingMode": "off" }
			}
		}
	}
}
