{
  "ui_font_family": ".SystemUIFont",
  "agent_ui_font_family": ".SystemUIFont",
  "ui_font_weight": 500.0,
  "terminal": {
    "font_family": "JetBrains Mono",
    "font_weight": 400.0,
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "xhigh",
        "model": "gpt-5.6-terra",
        "collaboration_mode": "plan",
      },
      "type": "registry",
    },
  },
  "collaboration_panel": { "button": false },

  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "button": true,
    "favorite_models": [],
    "model_parameters": [],
    "terminal_init_command": "codex",
  },

  "cli_default_open_behavior": "new_window",
  "vim_mode": false,
  "cursor_shape": "block",

  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 14.0,
  "ui_font_size": 15.0,

  "theme": {
    "mode": "dark",
    "light": "Min Dark (Solid)",
    "dark": "Moonlight II Italic",
  },

  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme (NestJS)",
    "dark": "Material Icon Theme (NestJS)",
  },

  "auto_install_extensions": {
    "html": true,
    "css": true,
    "emmet": true,
    "tailwindcss": true,
    "toml": true,
    "dockerfile": true,
    "docker-compose": true,
    "material-icon-theme": true,
    "mcp-server-context7": true,
    "python-requirements": true,
    "jinja2": true,
    "moonlight": true,
    "git-firefly": true,
    "just": true,
    "biome": true,
  },

  "project_panel": { "dock": "left", "auto_fold_dirs": false },
  "outline_panel": { "button": false, "dock": "right" },
  "git_panel": { "dock": "left" },
  "edit_predictions": { "provider": "none", "mode": "eager" },
  "telemetry": { "diagnostics": false, "metrics": false },

  // Configurações comuns a todos os projetos
  "format_on_save": "on",

  "profiles": {
    "Python — Ruff": {
      "base": "user",
      "settings": {
        "languages": {
          "Python": {
            "language_servers": ["basedpyright", "ruff", "!pylsp", "!pyright"],

            "format_on_save": "on",

            "formatter": {
              "language_server": {
                "name": "ruff",
              },
            },

            "code_actions_on_format": {
              "source.fixAll.ruff": true,
              "source.organizeImports.ruff": true,
            },
          },
        },

        "lsp": {
          "ruff": {
            "initialization_options": {
              "settings": {},
            },
          },
        },
      },
    },
    "Python — Black + isort + Flake8": {
      "base": "user",
      "settings": {
        "file_types": {
          "Jinja2": ["**/templates/**/*.html", "**/*.jinja", "**/*.jinja2"],
        },

        "languages": {
          "Python": {
            "language_servers": ["basedpyright", "pylsp", "!ruff", "!pyright"],
            "format_on_save": "on",

            "formatter": [
              {
                "external": {
                  "command": "isort",
                  "arguments": ["--stdout", "--filename", "{buffer_path}", "-"],
                },
              },
              {
                "external": {
                  "command": "black",
                  "arguments": ["--stdin-filename", "{buffer_path}", "-"],
                },
              },
            ],

            "code_actions_on_format": {
              "source.fixAll.ruff": false,
              "source.organizeImports.ruff": false,
            },
          },

          "Jinja2": {
            "format_on_save": "on",

            "formatter": {
              "external": {
                "command": "djlint",
                "arguments": [
                  "--reformat",
                  "--quiet",
                  "--profile",
                  "django",
                  "--stdin-filename",
                  "{buffer_path}",
                  "-",
                ],
              },
            },
          },
        },

        "lsp": {
          "pylsp": {
            "settings": {
              "pylsp": {
                "configurationSources": ["flake8"],

                "plugins": {
                  "flake8": {
                    "enabled": true,
                  },
                  "pycodestyle": {
                    "enabled": false,
                  },
                  "pyflakes": {
                    "enabled": false,
                  },
                  "mccabe": {
                    "enabled": false,
                  },
                  "autopep8": {
                    "enabled": false,
                  },
                  "yapf": {
                    "enabled": false,
                  },
                },
              },
            },
          },
        },
      },
    },
    "Node — Biome": {
      "base": "user",
      "settings": {
        "languages": {
          "JavaScript": {
            "language_servers": [
              "typescript-language-server",
              "biome",
              "!eslint",
            ],

            "format_on_save": "on",

            "formatter": {
              "language_server": {
                "name": "biome",
              },
            },

            "code_actions_on_format": {
              "source.fixAll.biome": true,
              "source.organizeImports.biome": true,
              "source.fixAll.eslint": false,
            },
          },

          "TypeScript": {
            "language_servers": [
              "typescript-language-server",
              "biome",
              "!eslint",
            ],

            "format_on_save": "on",

            "formatter": {
              "language_server": {
                "name": "biome",
              },
            },

            "code_actions_on_format": {
              "source.fixAll.biome": true,
              "source.organizeImports.biome": true,
              "source.fixAll.eslint": false,
            },
          },

          "TSX": {
            "language_servers": [
              "typescript-language-server",
              "biome",
              "!eslint",
            ],

            "format_on_save": "on",

            "formatter": {
              "language_server": {
                "name": "biome",
              },
            },

            "code_actions_on_format": {
              "source.fixAll.biome": true,
              "source.organizeImports.biome": true,
              "source.fixAll.eslint": false,
            },
          },

          "JSON": {
            "format_on_save": "on",

            "formatter": {
              "language_server": {
                "name": "biome",
              },
            },
          },

          "JSONC": {
            "format_on_save": "on",

            "formatter": {
              "language_server": {
                "name": "biome",
              },
            },
          },
        },
      },
    },
    "Node — Prettier + ESLint": {
      "base": "user",
      "settings": {
        "languages": {
          "JavaScript": {
            "language_servers": [
              "typescript-language-server",
              "eslint",
              "!biome",
            ],

            "format_on_save": "on",

            "formatter": [
              {
                "code_action": "source.fixAll.eslint",
              },
              {
                "external": {
                  "command": "prettier",
                  "arguments": ["--stdin-filepath", "{buffer_path}"],
                },
              },
            ],

            "code_actions_on_format": {
              "source.fixAll.biome": false,
              "source.organizeImports.biome": false,
            },
          },

          "TypeScript": {
            "language_servers": [
              "typescript-language-server",
              "eslint",
              "!biome",
            ],

            "format_on_save": "on",

            "formatter": [
              {
                "code_action": "source.fixAll.eslint",
              },
              {
                "external": {
                  "command": "prettier",
                  "arguments": ["--stdin-filepath", "{buffer_path}"],
                },
              },
            ],

            "code_actions_on_format": {
              "source.fixAll.biome": false,
              "source.organizeImports.biome": false,
            },
          },

          "TSX": {
            "language_servers": [
              "typescript-language-server",
              "eslint",
              "!biome",
            ],

            "format_on_save": "on",

            "formatter": [
              {
                "code_action": "source.fixAll.eslint",
              },
              {
                "external": {
                  "command": "prettier",
                  "arguments": ["--stdin-filepath", "{buffer_path}"],
                },
              },
            ],

            "code_actions_on_format": {
              "source.fixAll.biome": false,
              "source.organizeImports.biome": false,
            },
          },

          "JSON": {
            "language_servers": ["!biome", "..."],

            "format_on_save": "on",

            "formatter": {
              "external": {
                "command": "prettier",
                "arguments": ["--stdin-filepath", "{buffer_path}"],
              },
            },
          },

          "JSONC": {
            "language_servers": ["!biome", "..."],

            "format_on_save": "on",

            "formatter": {
              "external": {
                "command": "prettier",
                "arguments": ["--stdin-filepath", "{buffer_path}"],
              },
            },
          },

          "CSS": {
            "language_servers": ["!biome", "..."],
            "format_on_save": "on",
          },

          "HTML": {
            "language_servers": ["!biome", "..."],
            "format_on_save": "on",
          },
        },

        "lsp": {
          "eslint": {
            "settings": {
              "workingDirectory": {
                "mode": "auto",
              },
            },
          },
        },
      },
    },
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "analysis": {
            "typeCheckingMode": "off",
          },
        },
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "tailwindCSS": {
          "experimental": {
            "classRegex": [
              ["className\\s*=\\s*[\"'`]([^\"'`]*)[\"'`]"],
              ["clsx\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"],
              ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"],
            ],
          },
        },
      },
    },
  },
}
